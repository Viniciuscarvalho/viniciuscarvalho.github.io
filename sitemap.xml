---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in site.pages %}{% if page.layout and page.sitemap != false %}<url><loc>{{ page.url | absolute_url | xml_escape }}</loc></url>{% endif %}{% endfor %}
{% for post in site.posts %}<url><loc>{{ post.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
{% for app in site.apps %}<url><loc>{{ app.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
{% for project in site.projects %}<url><loc>{{ project.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
