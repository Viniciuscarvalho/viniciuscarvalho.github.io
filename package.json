{
  "name": "viniciuscarvalho-github-io",
  "private": true,
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tailwindcss/typography": "^0.5.15",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "gsap": "^3.15.0",
    "postcss": "^8.5.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.17",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i ./assets/css/main.css -o ./assets/css/site.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i ./assets/css/main.css -o ./assets/css/site.css --watch",
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run build:assets && npm run build:css",
    "snapshot": "node scripts/snapshot-github.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
